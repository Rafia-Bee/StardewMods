<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DeluxeGrabberFix</AssemblyName>
    <RootNamespace>DeluxeGrabberFix</RootNamespace>
    <Version>1.21.0</Version>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net6.0</TargetFramework>
    <EnableHarmony>true</EnableHarmony>
    <ModFolderName>DeluxeGrabberFix</ModFolderName>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableModZip>true</EnableModZip>
    <IgnoreModFilePaths>config.json</IgnoreModFilePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <!-- Newtonsoft.Json ships with SMAPI; this reference is for compile-time only and the mod-build-config excludes it from the release zip. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="docs/**" />
    <Compile Remove="hiddenDocs\**" />
    <None Remove="hiddenDocs\**" />
    <EmbeddedResource Remove="hiddenDocs\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeluxeGrabberFix.Tests" />
  </ItemGroup>
</Project>
